{
  "name": "claude-ollama-delegate-mcp",
  "version": "1.0.0",
  "description": "MCP server that delegates tasks to Ollama-backed Claude Code sessions without leaking env vars into the parent session",
  "keywords": [
    "mcp",
    "ollama",
    "claude-code",
    "model-context-protocol",
    "delegation",
    "llm"
  ],
  "homepage": "https://github.com/histonedev/claude-ollama-delegate-mcp#readme",
  "bugs": {
    "url": "https://github.com/histonedev/claude-ollama-delegate-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/histonedev/claude-ollama-delegate-mcp.git"
  },
  "license": "MIT",
  "author": "histonedev",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-ollama-delegate-mcp": "dist/index.js",
    "ollama-mcp-config": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "config": "node dist/cli.js",
    "prepare": "tsc",
    "test": "node test/env-unit.mjs && node test/quoting.mjs && node test/killtree-unit.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
